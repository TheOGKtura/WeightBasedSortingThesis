/* === MAIN BACKGROUND === */
QStackedWidget {
    background-color: qlineargradient(
        spread:pad,
        x1:0, y1:0,
        x2:1, y2:1,
        stop:0 #0d0d0d,
        stop:1 #1a1a1a
    );
}

/* === LABELS === */
QLabel {
    color: white;
    font-size: 16px;
    font-weight: bold;
}

/* === TEXT BROWSER === */
QTextBrowser#textProductDescription {
    background-color: #121212;
    color: white;
    border: 5px solid #333;
    border-radius: 12px;
    padding: 6px;
}

/* === BUTTONS === */
QPushButton {
    background-color: #2c3e50;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 10px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #34495e;
}

QPushButton:pressed {
    background-color: #1abc9c;
}

QPushButton:disabled {
    background-color: #555;
    color: #888;
}

QPushButton#startButton,
QPushButton#pauseButton,
QPushButton#parametersButton,
QPushButton#settingsButton {
    min-width: 160px;
    max-width: 160px;
    min-height: 80px;
    max-height: 80px;
}
/* === STATUS LABELS === */
#label_StatusState {
    color: #1abc9c;
    font-weight: bold;
}

/* === CAMERA FEED === */
#CameraFeed {
    background-color: black;
    border: 2px solid #333;
}

/* === PANEL === */
#Panel {
    background-color: #181818;
    border-right: 2px solid #333;
}

QLineEdit {
    border: 2px solid #ccc;
    border-radius: 10px;
    padding: 8px 12px;
    font-size: 14px;
    background-color: #fdfdfd;
}
QLineEdit:focus {
    border: 2px solid #4CAF50;
    background-color: #ffffff;
}
QScrollArea {
    border: none;
    background-color: transparent;
}
/* === Settings Page === */
#datetimeLabel, #uptimeLabel {
    color: #E0E0E0;
    font-size: 18px;
    font-weight: bold;
    padding: 6px;
}

#exitButton {
    background-color: #d32f2f;
    color: white;
    font-weight: bold;
    border-radius: 12px;
    padding: 10px;
}

#exitButton:hover {
    background-color: #b71c1c;
}

/* === Exit Dialog === */
#exitDialog {
    background-color: #2E2E2E;
    border: 2px solid #1ABC9C;
    border-radius: 15px;
}

#passwordPrompt {
    color: #E0E0E0;
    font-size: 16px;
}

#passwordInput {
    background-color: #1E1E1E;
    color: white;
    border: 1px solid #1ABC9C;
    border-radius: 6px;
    padding: 6px;
}

#passwordButtons QPushButton {
    background-color: #1ABC9C;
    color: white;
    border-radius: 6px;
    padding: 6px 12px;
}

#passwordButtons QPushButton:hover {
    background-color: #16A085;
}
